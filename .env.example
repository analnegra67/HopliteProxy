# Copy to .env and fill in. Empty values fall back to the defaults shown in app/config.py.

# --- required secrets: generate both with `python -m app.cli gen-secrets` ---------------------
# MASTER_KEY protects /admin/* (>= 32 chars; empty disables the admin API).
MASTER_KEY=
# Fernet key(s) that encrypt stored Hoplite keys. Comma-separated; the first one encrypts,
# all of them decrypt (rotate: prepend a new key, run `python -m app.cli rotate-encryption`).
ENCRYPTION_KEYS=

# --- server ---------------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Keep the database outside OneDrive/Dropbox folders: sync clients break SQLite locking.
DATABASE_PATH=data/proxy.db
HOPLITE_BASE_URL=https://api.hoplite.sh

# --- behaviour ------------------------------------------------------------------------------------
# fingerprint: a follow-up of a conversation continues the same Hoplite thread; off: new thread per request
THREAD_REUSE=fingerprint
# surface: return agent questions to the client; auto: answer them with QUESTION_AUTO_ANSWER
QUESTION_POLICY=surface
# Spend cap for each new thread in micro-dollars (1000000 = $1); 0 = no cap. Overridable per key.
DEFAULT_SPEND_LIMIT_MICROS=1000000
RUN_TIMEOUT_SECONDS=1800
STOP_ON_DISCONNECT=true
DISCONNECT_GRACE_SECONDS=60
KEEPALIVE_SECONDS=15
RESULT_CACHE_SECONDS=600
# JSON object mapping client model names to Hoplite model ids, e.g. {"gpt-4o": "gpt-6-sol"}
MODEL_ALIASES={}
# Expose Hoplite "thinking" messages as `reasoning_content`
INCLUDE_REASONING=false
# bridge: client tools (opencode, ...) are offered to the agent and returned as OpenAI tool_calls; reject: 400
TOOLS_MODE=bridge
TOOL_RESULT_MAX_CHARS=100000
TOOL_REPAIR_ATTEMPTS=2
MAX_CONCURRENCY_PER_KEY=4
CONVERSATION_TTL_DAYS=14

# --- security and logging ----------------------------------------------------------------------
BCRYPT_ROUNDS=12
# Comma-separated origins for browser clients; empty disables CORS
CORS_ORIGINS=
LOG_LEVEL=INFO
# json or text
LOG_FORMAT=json
# Never enable in production: logs full conversations
LOG_PROMPTS=false

# --- only for scripts/probe_hoplite.py and `python -m app.cli create-key` ------------------------
HOPLITE_API_KEY=
HOPLITE_PROJECT_ID=
